{
  "name": "@openclaw/diffs",
  "version": "2026.3.28",
  "private": true,
  "description": "OpenClaw diff viewer plugin",
  "type": "module",
  "scripts": {
    "build:viewer": "bun build src/viewer-client.ts --target browser --format esm --minify --outfile assets/viewer-runtime.js"
  },
  "dependencies": {
    "@pierre/diffs": "1.6.4",
    "@pierre/theme": "0.0.22",
    "@sinclair/typebox": "0.34.52",
    "playwright-core": "1.65.0"
  },
  "openclaw": {
